# ==============================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN EN VPS - CONTABILIDAD ARTURO
# ==============================================================================
# Copia este archivo a `.env.production` en el VPS:
# cp .env.production.example .env.production
# y completa todos los valores secretos.

# ------------------------------------------------------------------------------
# 1. DOMINIOS Y CERTIFICADOS SSL (CADDY)
# ------------------------------------------------------------------------------
DOMAIN_NAME=contabilidadarturo.com
APP_DOMAIN=app.contabilidadarturo.com
API_DOMAIN=api.contabilidadarturo.com
DB_DOMAIN=db.contabilidadarturo.com
EMAIL_ACME=admin@contabilidadarturo.com

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN BASE DE DATOS POSTGRESQL (VPS)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_MUY_SEGURO_AQUI
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Connection string interna para la red Docker del VPS
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/postgres

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y CLAVES JWT (SUPABASE SELF-HOSTED)
# ------------------------------------------------------------------------------
# JWT_SECRET debe tener al menos 32 caracteres aleatorios y seguros.
# Puedes generar uno con: openssl rand -base64 36
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_HEX_O_BASE64_DE_AL_MENOS_32_CARACTERES

# Anon Key y Service Role Key generadas con el JWT_SECRET anterior
# (El script scripts/generate_keys.py te genera ambas automáticamente)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URLs públicas y claves para Frontend y Backend
SUPABASE_URL=https://db.contabilidadarturo.com
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}

# Para el build del Frontend Next.js
NEXT_PUBLIC_API_URL=https://api.contabilidadarturo.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://db.contabilidadarturo.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=${ANON_KEY}

# ------------------------------------------------------------------------------
# 4. BACKEND & WORKER (FASTAPI & CELERY)
# ------------------------------------------------------------------------------
MOCK_MODE=False
PROJECT_NAME="Contabilidad Arturo"
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# CORS: Lista de orígenes permitidos separados por coma
CORS_ORIGINS=https://app.contabilidadarturo.com

# Asistente de IA (Opcional)
OPENAI_API_KEY=sk-...

# ------------------------------------------------------------------------------
# 5. CREDENCIALES DE ACCESO A SUPABASE STUDIO (PANEL WEB)
# ------------------------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION="Contabilidad Arturo"
STUDIO_DEFAULT_PROJECT="Produccion"
STUDIO_PORT=3001
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CAMBIAR_PASSWORD_PANEL_STUDIO
