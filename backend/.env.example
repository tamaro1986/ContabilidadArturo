# --- CONFIGURACIÓN REQUERIDA ---
MOCK_MODE=False
PROJECT_NAME="Contabilidad Arturo Production"

# Supabase (Obtener de Project Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-MUST-BE-SECRET"

# Base de Datos (Connection String)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Redis (Caché)
# Si usas Docker local: redis://redis:6379/0
# Si usas Upstash: rediss://default:[PASSWORD]@...
REDIS_URL="redis://localhost:6379/0"

# Seguridad
# Lista separada por comas de orígenes permitidos
CORS_ORIGINS="https://tu-app.vercel.app,http://localhost:3000"

# AI (Opcional si usas el asistente)
OPENAI_API_KEY="sk-..."
